---
import type { Oeuvre } from '../types/strapi';
import CarteOeuvre from './CarteOeuvre.astro';
import { CATALOGUE_GRILLE } from '../lib/image-presets';

interface Props {
  oeuvres: Oeuvre[];
  /** Catalogue filtrable : cartes marquées `data-thematiques`, cible de l'îlot `ChipThematique`. */
  filtrable?: boolean;
}

const { oeuvres, filtrable = false } = Astro.props;
---

<ul class="galerie-images" id={filtrable ? 'grille-oeuvres' : undefined}>
  {oeuvres.map((oeuvre, index) => (
    <li
      class:list={[(index + 1) % 5 === 0 && 'span-2']}
      data-thematiques={filtrable ? (oeuvre.thematiques ?? []).map((t) => t.slug).join(' ') : undefined}
    >
      <CarteOeuvre oeuvre={oeuvre} overlay={filtrable} imagePreset={CATALOGUE_GRILLE} />
    </li>
  ))}
</ul>

<style>
  .galerie-images {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  @media (min-width: 640px) {
    .galerie-images {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-2xl);
    }
  }

  @media (min-width: 1024px) {
    .galerie-images {
      grid-template-columns: repeat(3, 1fr);
    }

    .galerie-images .span-2 {
      grid-column: span 2;
    }
  }

  @media (min-width: 1280px) {
    .galerie-images {
      grid-template-columns: repeat(4, 1fr);
    }

    .galerie-images .span-2 {
      grid-column: span 1;
    }
  }
</style>
